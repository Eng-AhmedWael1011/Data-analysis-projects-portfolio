    <dashboard enable-sort-zone-taborder='true' name='Salary Analysis'>
      <style />
      <size maxheight='850' maxwidth='1700' minheight='850' minwidth='1700' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Fact_Performance+ (Analysis Sheet Update2 (2))' name='federated.1tlip730wzoyng1dc3y4r0k0w7s6' />
      </datasources>
      <datasource-dependencies datasource='federated.1tlip730wzoyng1dc3y4r0k0w7s6'>
        <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
        <column caption='Gender Dist' datatype='string' name='[Calculation_473440912554835974]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Gender] = &quot;Non-binary&quot; or [Gender] = &quot;Prefer Not To Say&quot;&#13;&#10;THEN &quot;Others&quot;&#13;&#10;ELSEIF  [Gender] = &quot;Male&quot; then &quot;Male&quot;&#13;&#10;ELSEIF  [Gender] = &quot;Female&quot; then &quot;Female&quot;&#13;&#10;END' />
        </column>
        <column caption='Stock Option Tiers' datatype='string' name='[Calculation_844706408906362884]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [StockOptionLevel] = 0 then &quot;None&quot; &#13;&#10;ELSEIF [StockOptionLevel] = 1 then &quot;Bronze Tier&quot;&#13;&#10;ELSEIF [StockOptionLevel] = 2 then &quot;Silver Tier&quot;&#13;&#10;ELSEIF [StockOptionLevel] = 3 then &quot;Gold Tier&quot;&#13;&#10;END' />
        </column>
        <column caption='Education Field' datatype='string' name='[EducationField]' role='dimension' type='nominal' />
        <column caption='Education Level' datatype='string' name='[EducationLevel]' role='dimension' type='nominal' />
        <column-instance column='[Attrition]' derivation='None' name='[none:Attrition:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_473440912554835974]' derivation='None' name='[none:Calculation_473440912554835974:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_844706408906362884]' derivation='None' name='[none:Calculation_844706408906362884:nk]' pivot='key' type='nominal' />
        <column-instance column='[EducationField]' derivation='None' name='[none:EducationField:nk]' pivot='key' type='nominal' />
