      <column caption='Avg Age' datatype='real' name='[Calculation_1090715537226522625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Age])' />
      </column>
      <column caption='Average Satisfaction ' datatype='real' name='[Calculation_1090715537227386882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;  [JobSatisfaction] +&#13;&#10;  [EnvironmentSatisfaction] +&#13;&#10;  [RelationshipSatisfaction]&#13;&#10;) / 3' />
      </column>
      <column caption='Total Employees hired' datatype='integer' name='[Calculation_1241867598891986944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([EmployeeID (DimEmployee)])' />
      </column>
      <column caption='Attrition Rate' datatype='real' default-format='p0.00%' name='[Calculation_1241867598892097537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([EmployeeID (DimEmployee)])' />
      </column>
      <column caption='Attrition count' datatype='integer' name='[Calculation_1241867598892937218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 end )' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1241867598925332491]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &gt; 17 AND [Age] &lt;= 25 THEN &quot;[18-25]&quot;&#13;&#10;ELSEIF [Age] &gt; 25 AND [Age] &lt;= 33 THEN &quot;[26-33]&quot;&#13;&#10;ELSEIF [Age] &gt; 33 AND [Age] &lt;= 41 THEN &quot;[34-41]&quot;&#13;&#10;ELSEIF [Age] &gt; 41 AND [Age] &lt;= 49 THEN &quot;[42-49]&quot;&#13;&#10;ELSEIF [Age] &gt; 49 THEN &quot;[49+]&quot;&#13;&#10;END' />
      </column>
      <column caption='Categorical Distance From Home' datatype='string' name='[Calculation_213358035883958278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DistanceFromHome] &gt; 0 and [DistanceFromHome] &lt;= 15 THEN &quot;Nearby&quot; &#13;&#10;ELSEIF [DistanceFromHome] &gt; 15 and [DistanceFromHome] &lt;= 30 THEN &quot;Moderate Distance&quot;&#13;&#10;ELSEIF [DistanceFromHome] &gt; 30 then &quot;Far Away&quot; &#13;&#10;END' />
      </column>
      <column caption='Average Env sat per employee' datatype='integer' name='[Calculation_429530817252986880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CEILING({ FIXED [EmployeeID] : AVG([EnvironmentSatisfaction]) })' />
      </column>
      <column caption='Count distinct Employee Id in Fact' datatype='integer' name='[Calculation_429530817259421697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([EmployeeID])' />
      </column>
      <column caption='Employee Percentage' datatype='integer' name='[Calculation_473440912516382720]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT([EmployeeID (DimEmployee)])' />
      </column>
      <column caption='Active Employees' datatype='integer' name='[Calculation_473440912537862145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum( if [Attrition] = &quot;No&quot; then 1 else 0 end )' />
      </column>
      <column caption='Gender Dist' datatype='string' name='[Calculation_473440912554835974]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Gender] = &quot;Non-binary&quot; or [Gender] = &quot;Prefer Not To Say&quot;&#13;&#10;THEN &quot;Others&quot;&#13;&#10;ELSEIF  [Gender] = &quot;Male&quot; then &quot;Male&quot;&#13;&#10;ELSEIF  [Gender] = &quot;Female&quot; then &quot;Female&quot;&#13;&#10;END' />
      </column>
      <column caption='Stock Option Tiers' datatype='string' name='[Calculation_844706408906362884]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [StockOptionLevel] = 0 then &quot;None&quot; &#13;&#10;ELSEIF [StockOptionLevel] = 1 then &quot;Bronze Tier&quot;&#13;&#10;ELSEIF [StockOptionLevel] = 2 then &quot;Silver Tier&quot;&#13;&#10;ELSEIF [StockOptionLevel] = 3 then &quot;Gold Tier&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Employee Salary Per Years' datatype='integer' name='[Calculation_844706408931586053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Salary])' />
      </column>
